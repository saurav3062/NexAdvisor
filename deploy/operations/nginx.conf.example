# Include limit_req_zone declarations in nginx's http {} context.
limit_req_zone $binary_remote_addr zone=nexadvisor_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=nexadvisor_auth:10m rate=5r/m;
server {
    listen 80;
    server_name nexadvisor.in;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name nexadvisor.in;
    ssl_certificate /etc/letsencrypt/live/nexadvisor.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nexadvisor.in/privkey.pem;
    client_max_body_size 3m;
    limit_req_status 429;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_connect_timeout 5s;
    proxy_read_timeout 30s;
    location ~ ^/api/v1/auth/(register|login|forgot-password|reset-password|verify-email)$ {
        limit_req zone=nexadvisor_auth burst=10 nodelay;
        proxy_pass http://127.0.0.1:3000;
    }
    location /api/ {
        limit_req zone=nexadvisor_api burst=30 nodelay;
        proxy_pass http://127.0.0.1:3000;
    }
    location / { proxy_pass http://127.0.0.1:3000; }
}
