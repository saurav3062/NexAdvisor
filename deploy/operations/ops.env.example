PUBLIC_ORIGIN=https://nexadvisor.in
OPS_STATE_DIR=/var/lib/nexadvisor-ops
# Private HTTPS webhook accepting a JSON {text: ...} alert. Never commit the real URL.
OPS_ALERT_WEBHOOK=
# Initialize an encrypted off-host repository with restic init before enabling timers.
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/etc/nexadvisor/restic-password
# Configure your storage-provider credentials privately here as required by restic.
