[Unit]
Description=NexAdvisor Service and backup monitoring
After=network-online.target docker.service
Wants=network-online.target
[Service]
Type=oneshot
User=nexadvisor-ops
WorkingDirectory=/opt/NexAdvisor
EnvironmentFile=/etc/nexadvisor/ops.env
ExecStart=/usr/bin/node scripts/operations/monitor.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
TimeoutStartSec=3600
