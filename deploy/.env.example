# Copy to deploy/.env. Supply real values before starting.
DATABASE_PASSWORD=
PUBLIC_ORIGIN=https://advisor.example.com
# Emails are private file previews. No SMTP credentials are needed.
# Initial administrator only. Remove these after the first successful start.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Frontend binds only to loopback; put your HTTPS reverse proxy in front of it.
WEB_PORT=3000
