# Spring Boot reads process environment variables; this file is documentation.
DATABASE_URL=jdbc:postgresql://localhost:5433/nexadvisor
DATABASE_USER=nexadvisor
DATABASE_PASSWORD=replace-with-local-secret
COOKIE_SECURE=false
PAYMENT_SIMULATION_ENABLED=true
PORT=8081
# Optional first-admin bootstrap. Existing accounts are never silently promoted.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Default profile: set SMTP and HTTPS origin for real email delivery.
# The demo profile writes private local previews instead.
PUBLIC_ORIGIN=http://localhost:3000
MAIL_MODE=DISABLED
MAIL_FROM=noreply@example.test
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
